# Codex 命令规则示例。
# 放在哪里：~/.codex/rules/default.rules。整份文件可以直接复制，# 开头的注释行 Codex 会忽略。
#
# 每行一条 prefix_rule：命令的开头几个词与 pattern 完全相同时，按 decision 处理。
# decision 有三种：allow 直接执行，prompt 每次先询问，forbidden 拒绝执行。
# pattern 里某一位可以写成列表，表示这一位是其中任意一个词。
# justification 是可选的一句说明，写给以后看这条规则的人。
#
# 改完后怎样确认规则写对了（不会真的执行后面的命令，只输出这条命令会得到哪个决定）：
#   codex execpolicy check --rules ~/.codex/rules/default.rules git status
#   codex execpolicy check --rules ~/.codex/rules/default.rules git push origin main
# 输出里的 "decision" 就是结果；"matchedRules" 为空表示没有规则管到它，Codex 按你的审批设置处理。
#
# 规则只比较命令开头的几个词。git -C 某目录 reset 这类把参数插在前面的写法、
# 包在 bash -c 里的命令、读写 /tmp 的各种写法，prefix_rule 管不到，这些仍然要写进项目手册。

# 一、放行：只读命令和本地门禁命令
prefix_rule(pattern=["git", "status"], decision="allow")
prefix_rule(pattern=["git", "diff"], decision="allow")
prefix_rule(pattern=["git", "log"], decision="allow")
prefix_rule(pattern=["git", "remote", "-v"], decision="allow")
prefix_rule(pattern=["gh", "pr", "view"], decision="allow")
prefix_rule(pattern=["gh", "pr", "diff"], decision="allow")
prefix_rule(pattern=["gh", "auth", "status"], decision="allow")
prefix_rule(pattern=["npm", "run", "verify"], decision="allow")
prefix_rule(pattern=["npm", "run", "lint"], decision="allow")
prefix_rule(pattern=["npm", "test"], decision="allow")

# 二、每次先询问：会产生对外影响的命令
prefix_rule(pattern=["git", "commit"], decision="prompt")
prefix_rule(pattern=["git", "push"], decision="prompt")
prefix_rule(pattern=["gh", "pr", ["create", "merge"]], decision="prompt")

# 三、拒绝执行：用 git 丢弃改动的命令
prefix_rule(pattern=["git", ["reset", "restore", "revert", "stash", "clean"]], decision="forbidden", justification="需要恢复时用文件编辑工具手动改回")
prefix_rule(pattern=["git", "checkout", "--"], decision="forbidden", justification="需要恢复时用文件编辑工具手动改回")
